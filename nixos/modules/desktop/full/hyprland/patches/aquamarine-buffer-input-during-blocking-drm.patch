@@ -1009,7 +1009,11 @@ void Aquamarine::CDRMBackend::recheckOutputs() {
 
             backend->log(AQ_LOG_DEBUG, std::format("drm: Connector {} connected", conn->szName));
 
-            auto drmConn = drmModeGetConnector(gpu->fd, conn->id);
+            drmModeConnector* drmConn = nullptr;
+            runBufferingInput([&] {
+                drmConn = drmModeGetConnector(gpu->fd, conn->id);
+                return 0;
+            });
 
             // ??? was valid 5 sec ago...
             if (!drmConn) {
@@ -1026,6 +1030,15 @@ void Aquamarine::CDRMBackend::recheckOutputs() {
         backend->log(AQ_LOG_ERROR, std::format("drm: Failed to update renderer state for {}", gpu->path));
 }
 
+// Forced connector probes are slow (nvidia re-reads the EDID, ~200ms per connector) and run on the compositor's
+// main thread on every hotplug uevent; keep input flowing into libinput meanwhile.
+void Aquamarine::CDRMBackend::runBufferingInput(const std::function<int()>& fn) {
+    if (backend && backend->session)
+        backend->session->runBufferingInput(fn);
+    else
+        fn();
+}
+
 void Aquamarine::CDRMBackend::scanConnectors() {
     backend->log(AQ_LOG_DEBUG, std::format("drm: Scanning connectors for {}", gpu->path));
 
@@ -1035,11 +1048,20 @@ void Aquamarine::CDRMBackend::scanConnectors() {
         return;
     }
 
+    // drmModeGetConnector forces a probe; batch them so input is buffered across all of them
+    std::vector<drmModeConnector*> probed(resources->count_connectors, nullptr);
+    runBufferingInput([&] {
+        for (int i = 0; i < resources->count_connectors; ++i) {
+            probed[i] = drmModeGetConnector(gpu->fd, resources->connectors[i]);
+        }
+        return 0;
+    });
+
     for (int i = 0; i < resources->count_connectors; ++i) {
         uint32_t          connectorID = resources->connectors[i];
 
         SP<SDRMConnector> conn;
-        auto              drmConn = drmModeGetConnector(gpu->fd, connectorID);
+        auto              drmConn = probed[i];
 
         backend->log(AQ_LOG_DEBUG, std::format("drm: Scanning connector id {}", connectorID));
 
diff --git a/src/backend/drm/impl/Atomic.cpp b/src/backend/drm/impl/Atomic.cpp
index 421acaf..de9ccf1 100644
--- a/src/backend/drm/impl/Atomic.cpp
+++ b/src/backend/drm/impl/Atomic.cpp
@@ -378,7 +378,13 @@ bool Aquamarine::CDRMAtomicRequest::commit(uint32_t flagssss) {
     const bool WANTSFLIP = conn && conn->crtc && (flagssss & DRM_MODE_PAGE_FLIP_EVENT) && !(flagssss & DRM_MODE_ATOMIC_TEST_ONLY);
     const auto FLIPID    = WANTSFLIP ? conn->crtc->armPageFlip(conn, flagssss & DRM_MODE_PAGE_FLIP_ASYNC) : uintptr_t{0};
 
-    if (auto ret = drmModeAtomicCommit(backend->gpu->fd, req, flagssss, rc<void*>(FLIPID)); ret) {
+    // Blocking commits are modesets, which on nvidia take hundreds of ms each (link training) on the main
+    // thread; keep input flowing into libinput meanwhile so it can't overflow and drop keystrokes.
+    const auto COMMIT   = [&] { return drmModeAtomicCommit(backend->gpu->fd, req, flagssss, rc<void*>(FLIPID)); };
+    const auto SESSION  = backend->backend ? backend->backend->session : nullptr;
+    const bool BLOCKING = !(flagssss & (DRM_MODE_ATOMIC_NONBLOCK | DRM_MODE_ATOMIC_TEST_ONLY));
+
+    if (auto ret = BLOCKING && SESSION ? SESSION->runBufferingInput(COMMIT) : COMMIT(); ret) {
         backend->log((flagssss & DRM_MODE_ATOMIC_TEST_ONLY) ? AQ_LOG_DEBUG : AQ_LOG_ERROR,
                      std::format("atomic drm request: failed to commit: {}, flags: {}", strerror(ret == -1 ? errno : -ret), flagsToStr(flagssss)));
 
