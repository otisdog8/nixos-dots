diff --git a/src/backend/Session.cpp b/src/backend/Session.cpp
index bc84a69..491a6a2 100644
--- a/src/backend/Session.cpp
+++ b/src/backend/Session.cpp
@@ -1,6 +1,8 @@
 #include <aquamarine/backend/Backend.hpp>
 #include <cerrno>
 #include <fcntl.h>
+#include <thread>
