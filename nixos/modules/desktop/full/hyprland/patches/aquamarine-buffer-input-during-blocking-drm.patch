 include/aquamarine/backend/Session.hpp |  8 ++++
 src/backend/Session.cpp                | 58 ++++++++++++++++++++++++++
 src/backend/drm/DRM.cpp                | 26 +++++++++++-
 src/backend/drm/impl/Atomic.cpp        |  8 +++-
 5 files changed, 98 insertions(+), 3 deletions(-)

