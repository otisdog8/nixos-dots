@@ -498,6 +502,60 @@ void Aquamarine::CSession::dispatchLibinputEvents() {
     }
 }
 
+int Aquamarine::CSession::runBufferingInput(const std::function<int()>& fn) {
+    if (!libinputHandle)
+        return fn();
+
+    const int doneFD = eventfd(0, EFD_CLOEXEC);
+    if (doneFD < 0)
+        return fn();
+
+    int         ret = 0, err = 0;
+    std::thread worker;
+    try {
+        worker = std::thread([&] {
+            ret                = fn();
+            err                = errno;
+            const uint64_t ONE = 1;
+            write(doneFD, &ONE, sizeof(ONE));
+        });
+    } catch (const std::system_error&) {
+        close(doneFD);
+        return fn();
+    }
+
+    // Only buffer here (libinput_dispatch); handling events means running compositor code, which
+    // must not happen in the middle of the caller's commit/scan.
+    bool   buffered = false;
+    pollfd fds[2]   = {{.fd = doneFD, .events = POLLIN, .revents = 0}, {.fd = libinput_get_fd(libinputHandle), .events = POLLIN, .revents = 0}};
+    while (!(fds[0].revents & POLLIN)) {
+        if (poll(fds, 2, -1) < 0) {
+            if (errno == EINTR)
+                continue;
+            break; // just wait for the worker
+        }
+
+        if (fds[1].revents & POLLIN) {
+            libinput_dispatch(libinputHandle);
+            buffered = true;
+        } else if (fds[1].revents & (POLLERR | POLLHUP | POLLNVAL))
+            fds[1].fd = -1;
+    }
+
+    worker.join();
+    close(doneFD);
+
+    // the libinput fd no longer polls readable for what was buffered, so hand it to the normal dispatch
+    if (buffered && backend)
+        backend->addIdleEvent(makeShared<std::function<void()>>([weak = self] {
+            if (auto session = weak.lock())
+                session->dispatchLibinputEvents();
+        }));
+
+    errno = err;
+    return ret;
+}
+
 void Aquamarine::CSession::dispatchLibseatEvents() {
     if (libseat_dispatch(libseatHandle, 0) == -1)
         backend->log(AQ_LOG_ERROR, "Couldn't dispatch libseat events");
diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
