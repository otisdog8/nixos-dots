   g_hash_table_destroy (proxy->filters);
+  g_list_free_full (proxy->own_numbered, g_free);
 
   g_free (proxy->socket_path);
   g_free (proxy->dbus_address);
@@ -2189,6 +2234,21 @@
   return FALSE;
 }
 
+/* A RequestName or ReleaseName of a name an --own-numbered rule covers. */
+static gboolean
+is_own_numbered_request (FlatpakProxyClient *client, Header *header, Buffer *buffer)
+{
+  g_autofree char *name = NULL;
+
+  if (g_strcmp0 (header->member, "RequestName") != 0 &&
+      g_strcmp0 (header->member, "ReleaseName") != 0)
+    return FALSE;
+
+  name = get_arg0_string (buffer);
+  return name != NULL &&
+         flatpak_proxy_name_is_own_numbered (client->proxy, name);
+}
