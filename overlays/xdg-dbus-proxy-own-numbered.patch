+static GVariant *
+request_name (GDBusConnection *conn,
+              const char      *name,
+              GError         **error)
+{
+  return g_dbus_connection_call_sync (conn,
+                                      DBUS_SERVICE_DBUS,
+                                      DBUS_PATH_DBUS,
+                                      DBUS_INTERFACE_DBUS,
+                                      "RequestName",
+                                      g_variant_new ("(su)", name,
+                                                     G_BUS_NAME_OWNER_FLAGS_DO_NOT_QUEUE),
+                                      G_VARIANT_TYPE ("(u)"),
+                                      G_DBUS_CALL_FLAGS_NONE,
+                                      -1,
+                                      NULL,    /* cancellable */
+                                      error);
+}
+
+/* --own-numbered=NAME: NAME-<digits>[-<digits>...] may be owned, nothing else
+ * may, and it gives no access to another owner of such a name. */
+static void
+test_own_numbered (Fixture *f,
+                   gconstpointer context G_GNUC_UNUSED)
+{
+  static const char * const allowed[] =
+  {
+    OWN_NUMBERED_NAME "-629-1",
+    OWN_NUMBERED_NAME "-7",
+  };
+  static const char * const refused[] =
+  {
+    OWN_NUMBERED_NAME,
+    OWN_NUMBERED_NAME "-",
+    OWN_NUMBERED_NAME "-1-",
+    OWN_NUMBERED_NAME "--1",
+    OWN_NUMBERED_NAME "-1x",
+    OWN_NUMBERED_NAME "-x1",
+    OWN_NUMBERED_NAME "-1.Sub",
+    OWN_NUMBERED_NAME ".Sub",
+    OWN_NUMBERED_NAME ".Sub-1",
+    OWN_NUMBERED_NAME "X-1",
+    "com.example.Other-1",
+  };
+  const char *theirs = OWN_NUMBERED_NAME "-99-1";
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) tuple = NULL;
+  guint32 result = 0;
+  gboolean has_owner = TRUE;
+
+  alarm (30);
+  fixture_start_proxy (f);
+
+  for (size_t i = 0; i < G_N_ELEMENTS (allowed); i++)
+    {
+      g_test_message ("should be allowed to own %s", allowed[i]);
+      tuple = request_name (f->proxied.conn, allowed[i], &error);
+      g_assert_no_error (error);
+      g_assert_nonnull (tuple);
+      g_variant_get (tuple, "(u)", &result);
+      g_assert_cmpuint (result, ==, DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER);
+      g_clear_pointer (&tuple, g_variant_unref);
+    }
+
+  for (size_t i = 0; i < G_N_ELEMENTS (refused); i++)
+    {
+      g_test_message ("should not be allowed to own %s", refused[i]);
+      tuple = request_name (f->proxied.conn, refused[i], &error);
+      g_assert_null (tuple);
+      g_assert_error (error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN);
+      g_clear_error (&error);
+    }
+
+  /* Another connection owns a covered name: the sandboxed one may ask for
+   * it (and is told it is taken), but can neither see nor call its owner. */
+  tuple = request_name (f->cannot_access_conn.conn, theirs, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (tuple);
+  g_clear_pointer (&tuple, g_variant_unref);
+
+  tuple = request_name (f->proxied.conn, theirs, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (tuple);
+  g_variant_get (tuple, "(u)", &result);
+  g_assert_cmpuint (result, ==, DBUS_REQUEST_NAME_REPLY_EXISTS);
+  g_clear_pointer (&tuple, g_variant_unref);
+
+  tuple = g_dbus_connection_call_sync (f->proxied.conn, DBUS_SERVICE_DBUS,
+                                       DBUS_PATH_DBUS, DBUS_INTERFACE_DBUS,
+                                       "NameHasOwner",
+                                       g_variant_new ("(s)", theirs),
+                                       G_VARIANT_TYPE ("(b)"),
+                                       G_DBUS_CALL_FLAGS_NONE, -1, NULL,
+                                       &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (tuple);
+  g_variant_get (tuple, "(b)", &has_owner);
+  g_assert_false (has_owner);
+  g_clear_pointer (&tuple, g_variant_unref);
+
+  tuple = g_dbus_connection_call_sync (f->proxied.conn, theirs,
+                                       "/", DBUS_INTERFACE_PEER,
+                                       "Ping", NULL,
+                                       G_VARIANT_TYPE_UNIT,
+                                       G_DBUS_CALL_FLAGS_NONE, -1, NULL,
+                                       &error);
+  g_assert_null (tuple);
+  g_assert_error (error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN);
+  g_clear_error (&error);
+
+  /* The direct connection can ping it: the name is really there. */
+  tuple = g_dbus_connection_call_sync (f->cannot_access_conn.conn,
+                                       OWN_NUMBERED_NAME "-629-1",
+                                       "/", DBUS_INTERFACE_PEER,
+                                       "Ping", NULL,
+                                       G_VARIANT_TYPE_UNIT,
+                                       G_DBUS_CALL_FLAGS_NONE, -1, NULL,
+                                       &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (tuple);
+}
+
