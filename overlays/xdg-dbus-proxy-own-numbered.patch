+/* --own-numbered=NAME: the client may request and release the names
+ * NAME-<digits>[-<digits>...] (e.g. a StatusNotifierItem's NAME-<pid>-<id>),
+ * and nothing else. Unlike --own this is not a policy on those names: it
+ * gives no SEE or TALK, so the client can neither see nor call another
+ * connection that owns one. */
+void
+flatpak_proxy_add_own_numbered (FlatpakProxy *proxy,
+                                const char   *name)
+{
+  proxy->own_numbered = g_list_append (proxy->own_numbered, g_strdup (name));
+}
+
+static gboolean
+flatpak_proxy_name_is_own_numbered (FlatpakProxy *proxy,
+                                    const char   *name)
+{
+  GList *l;
+
+  for (l = proxy->own_numbered; l != NULL; l = l->next)
+    {
+      const char *base = l->data;
+      const char *p;
+
+      if (!g_str_has_prefix (name, base))
+        continue;
+
+      /* One or more "-<digits>" groups, up to the end of the name. */
+      p = name + strlen (base);
+      if (*p != '-')
+        continue;
+      while (*p == '-' && g_ascii_isdigit (p[1]))
+        {
+          p++;
+          while (g_ascii_isdigit (*p))
+            p++;
+        }
+      if (*p == 0)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
 void
 flatpak_proxy_add_call_rule (FlatpakProxy *proxy,
                              const char   *name,
