+/* Accept the pre-timeline 16-byte syncobj handle ABI as well as the
+ * current structure. Never read or write beyond the caller's encoded size;
+ * the absent timeline point is zero, as in the DRM core's ioctl handling.
+ */
+static int nvgpu_fence_copy_handle(unsigned int cmd, unsigned int want,
+                                    struct drm_syncobj_handle *a,
+                                    const void __user *uarg) {
+  unsigned int legacy = (want & ~(_IOC_SIZEMASK << _IOC_SIZESHIFT)) |
+                        (16U << _IOC_SIZESHIFT);
+
+  if (cmd != want && cmd != legacy)
+    return -EINVAL;
+  memset(a, 0, sizeof(*a));
+  return copy_from_user(a, uarg, _IOC_SIZE(cmd)) ? -EFAULT : 0;
+}
